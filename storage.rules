rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Materiais de treinamento: autenticados leem, só admin escreve/apaga
    match /treinamentos/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.token.admin == true;
    }
    // Banners (GIF/MP4 grandes vão pro Storage)
    match /banners/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.token.admin == true;
    }
    // Documentos das fichas do locador: formulário público (cliente não autenticado).
    // Limita a imagem/PDF e 20MB — evita hospedar conteúdo arbitrário no bucket.
    match /fichas-locador/{fichaId}/{arquivo} {
      allow create: if request.resource.size < 20 * 1024 * 1024 && ehImagemOuPdf();
      allow read:   if request.auth != null;
    }
    // Documentos das fichas genéricas (pf, pj, etc.)
    match /fichas/{tipo}/{fichaId}/{arquivo} {
      allow create: if request.resource.size < 20 * 1024 * 1024 && ehImagemOuPdf();
      allow read:   if request.auth != null;
    }
    // Templates de Marketing (HTML editável + capas): autenticados leem;
    // só admin ou quem tem a permissão marketing_gerenciar escreve/apaga.
    match /marketing/{sanfonaId}/{arquivo} {
      allow read:   if request.auth != null;
      allow write:  if podeMarketing()
             && request.resource.size < 10 * 1024 * 1024
             && ehHtmlOuImagem();
      allow delete: if podeMarketing();
    }
    function ehImagemOuPdf() {
      return request.resource.contentType.matches('image/.*')
             || request.resource.contentType == 'application/pdf';
    }
    function ehHtmlOuImagem() {
      return request.resource.contentType.matches('image/.*')
             || request.resource.contentType.matches('text/html.*');
    }
    // Gerenciar Marketing é permissão à parte — NÃO herda de admin, só marketing_gerenciar.
    function podeMarketing() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/user_access/$(request.auth.uid)).data.marketing_gerenciar == true;
    }
    // Documentos da Gestão de Locações (docs do locatário, apólice da garantia).
    // Gestor/administrativo (ou admin) enviam; autenticados leem. Só imagem/PDF, ≤20MB.
    match /locacao/{imovelId}/{allPaths=**} {
      allow read:   if request.auth != null;
      allow write:  if podeLocacao() && request.resource.size < 20 * 1024 * 1024 && ehImagemOuPdf();
      allow delete: if podeLocacao();
    }
    function podeLocacao() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.locRole == 'gestor' ||
        request.auth.token.locRole == 'administrativo'
      );
    }
  }
}
