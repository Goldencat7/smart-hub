{
  "name": "remax-smart-hub",
  "productName": "Remax Smart Hub",
  "version": "1.0.173",
  "description": "Hub interno da Remax Smart — acesso rápido às plataformas com autologin via Firebase.",
  "main": "main.js",
  "type": "commonjs",
  "author": {
    "name": "Nathan Gabriel do Vale Almeida",
    "email": "nathangabrieldovale07@gmail.com"
  },
  "copyright": "Copyright (c) 2026 Nathan Gabriel do Vale Almeida. Todos os direitos reservados.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "firebase emulators:exec --only firestore --project demo-smart-hub \"node --test --test-reporter=spec test/rules/firestore.test.mjs\"",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions --project demo-smart-hub \"node --test --test-concurrency=1 --test-reporter=spec test/functions/callables.test.mjs\"",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "publish": "electron-builder --publish always",
    "build:pwa": "node scripts/build-pwa.js",
    "serve:pwa": "node scripts/serve-pwa.js",
    "deploy:pwa": "node scripts/build-pwa.js && firebase deploy --only hosting --project remax-smart-hub",
    "emu": "node scripts/emu.js",
    "emu:seed": "node scripts/emu-seed.js",
    "deploy:staging": "node scripts/build-pwa.js && firebase deploy --only hosting,functions,firestore:rules,storage --project staging"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "firebase": "^12.17.1",
    "globals": "^17.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "com.remaxsmart.hub",
    "productName": "Remax Smart Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "*.js",
      "styles.css",
      "broker.css",
      "vendor/**",
      "logo.png",
      "app-icons/**",
      "marketing/**",
      "!marketing/template/**",
      "public/**",
      "!public/app/**",
      "!functions/**",
      "!release/**",
      "!.firebase/**",
      "!firestore.rules",
      "!firebase.json",
      "!.firebaserc"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "artifactName": "Remax-Smart-Hub-${version}.${ext}",
      "category": "public.app-category.business"
    },
    "dmg": {
      "title": "Remax Smart Hub"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Remax-Smart-Hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remax Smart Hub"
    },
    "publish": {
      "provider": "github",
      "owner": "Goldencat7",
      "repo": "smart-hub",
      "releaseType": "release"
    }
  }
}
