{
  "name": "remax-smart-hub",
  "productName": "Remax Smart Hub",
  "version": "1.0.102",
  "description": "Hub interno da Remax Smart — acesso rápido às plataformas com autologin via Firebase.",
  "main": "main.js",
  "type": "commonjs",
  "author": {
    "name": "Remax Smart"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "publish": "electron-builder --publish always",
    "build:pwa": "node scripts/build-pwa.js",
    "serve:pwa": "node scripts/serve-pwa.js",
    "deploy:pwa": "node scripts/build-pwa.js && firebase deploy --only hosting --project remax-smart-hub",
    "emu": "node scripts/emu.js",
    "emu:seed": "node scripts/emu-seed.js",
    "deploy:staging": "node scripts/build-pwa.js && firebase deploy --only hosting,functions,firestore:rules,storage --project staging"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "globals": "^17.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "com.remaxsmart.hub",
    "productName": "Remax Smart Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "*.js",
      "styles.css",
      "logo.png",
      "app-icons/**",
      "marketing/**",
      "!marketing/template/**",
      "public/**",
      "!public/app/**",
      "!functions/**",
      "!release/**",
      "!.firebase/**",
      "!firestore.rules",
      "!firebase.json",
      "!.firebaserc"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "artifactName": "Remax-Smart-Hub-${version}.${ext}",
      "category": "public.app-category.business"
    },
    "dmg": {
      "title": "Remax Smart Hub"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Remax-Smart-Hub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remax Smart Hub"
    },
    "publish": {
      "provider": "github",
      "owner": "Goldencat7",
      "repo": "remax-smart-hub",
      "releaseType": "release"
    }
  }
}
