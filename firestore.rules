rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueia tudo por padrão — Cloud Functions usam Admin SDK e ignoram estas regras.
    match /{document=**} {
      allow read, write: if false;
    }

    // Presença online: cada usuário lê/escreve o próprio doc; admin lê todos.
    match /user_presence/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Notificações: admin lê diretamente (para onSnapshot em tempo real de "quem viu").
    match /notifications/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Bloco de notas pessoal: cada usuário lê/escreve só o próprio doc.
    match /user_notes/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.notas is list;
    }

    // Fichas do locador — cliente anônimo cria/edita, mas com validação:
    // - corretorUid obrigatório e imutável (impede trocar o dono)
    // - status do client-side sempre 'aguardando_corretor' (Admin SDK muda pra outros)
    match /fichas_locador/{id} {
      allow get: if true;
      allow create: if request.resource.data.corretorUid is string
                    && request.resource.data.corretorUid.size() > 0
                    && request.resource.data.status == 'aguardando_corretor'
                    && semObsCorretor();
      allow update: if request.resource.data.corretorUid == resource.data.corretorUid
                    && request.resource.data.status == 'aguardando_corretor'
                    && semObsCorretor();
      allow list: if request.auth != null && request.auth.token.admin == true;
    }

    // Fichas genéricas (pf, pj, vendedor, locacao_fiador, proposta) — mesmo modelo + tipo imutável.
    match /fichas/{id} {
      allow get: if true;
      allow create: if request.resource.data.corretorUid is string
                    && request.resource.data.corretorUid.size() > 0
                    && request.resource.data.tipo is string
                    && request.resource.data.status == 'aguardando_corretor'
                    && semObsCorretor();
      allow update: if request.resource.data.corretorUid == resource.data.corretorUid
                    && request.resource.data.tipo == resource.data.tipo
                    && request.resource.data.status == 'aguardando_corretor'
                    && semObsCorretor();
      allow list: if request.auth != null && request.auth.token.admin == true;
    }

    // A observação do corretor só é escrita pelas Cloud Functions (Admin SDK, que
    // ignora estas regras). No caminho anônimo (cliente preenchendo/editando) ela
    // precisa ficar vazia — impede plantar payload de XSS via write direto.
    function semObsCorretor() {
      return !('observacaoCorretor' in request.resource.data)
             || request.resource.data.observacaoCorretor == '';
    }

    // ─── Gestão de Locações · Bloco 1 ──────────────────────────────────────
    // Perfil vem da claim `locRole`; o bootstrap admin do Hub entra como gestor
    // pra conseguir criar o 1º gestor real (espelha a lógica das functions).
    function locGestor() {
      return request.auth != null
             && (request.auth.token.locRole == 'gestor'
                 || request.auth.uid == 'OwcT6wCrXMgJ0tPADMUdKdBB8h32');
    }
    function locAdministrativo() {
      return request.auth != null && request.auth.token.locRole == 'administrativo';
    }
    // Gestor e Administrativo leem tudo; corretor só o que ele captou.
    function locGestorOuAdmin() { return locGestor() || locAdministrativo(); }
    function locDono(rec) {
      return request.auth != null && rec.corretorUid == request.auth.uid;
    }
    function locPodeLer(rec) { return locGestorOuAdmin() || locDono(rec); }

    // Regra de ouro: leitura por corretorUid (corretor vê só os seus).
    // ESCRITA é sempre negada aqui — toda mutação passa por Cloud Function
    // (Admin SDK ignora estas regras), pra garantir integridade do financeiro.
    match /imoveis/{id}   { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /pessoas/{id}   { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /contratos/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /garantias/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /cobrancas/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /repasses/{id}  { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /vistorias/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }

    // Perfis: cada um lê o seu; o gestor lista todos (pra futura tela de admin).
    match /loc_perfis/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || locGestor());
      allow write: if false; // só via Cloud Function (locDefinirPerfil)
    }
  }
}
