rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueia tudo por padrão — Cloud Functions usam Admin SDK e ignoram estas regras.
    match /{document=**} {
      allow read, write: if false;
    }

    // Presença online: cada usuário lê/escreve o próprio doc; admin lê todos.
    match /user_presence/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Notificações: admin lê diretamente (para onSnapshot em tempo real de "quem viu").
    match /notifications/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Fichas do locador. O acesso do corretor/admin é via Cloud Functions (Admin SDK).
    // Cliente é anônimo: cria pelo formulário e edita pelo link (o ID do doc é o segredo).
    // get/update liberados por link; list (enumerar tudo) só admin.
    match /fichas_locador/{id} {
      allow get, create, update: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
    }
    // Fichas genéricas (pf, pj, vendedor, locacao_fiador, proposta) — mesmo modelo.
    match /fichas/{id} {
      allow get, create, update: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
