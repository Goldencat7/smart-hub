rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueia tudo por padrão — Cloud Functions usam Admin SDK e ignoram estas regras.
    match /{document=**} {
      allow read, write: if false;
    }

    // Presença online: cada usuário lê/escreve o próprio doc; admin lê todos.
    match /user_presence/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Notificações: admin lê diretamente (para onSnapshot em tempo real de "quem viu").
    match /notifications/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Sinal de tempo real "recebeu ficha" (padrão campainha): só o dono LÊ (onSnapshot),
    // sem PII no doc (só contador/timestamps). Escrita só via Cloud Function (_bumpUserFeed).
    match /user_feed/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Broadcast de tempo real (status de apps, banners, avisos): doc ÚNICO com contadores,
    // SEM PII. Qualquer logado LÊ (onSnapshot); escrita só via Cloud Function (_bumpBroadcast).
    // Casa só com config/broadcast — o resto de config/ (seguranca, release, banner) segue fechado.
    match /config/broadcast {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Novidades (patch notes): sem PII, qualquer logado LÊ; escrita só via Cloud
    // Function (salvarNovidade/excluirNovidade, admin).
    match /novidades/{id} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Bloco de notas pessoal: cada usuário lê/escreve só o próprio doc.
    match /user_notes/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.notas is list;
    }

    // Fichas — o cliente preenche por link, sem login.
    //
    // ESCRITA é sempre negada aqui: toda criação/edição passa pela Cloud Function
    // `salvarFichaPublica` (Admin SDK, que ignora estas regras). Antes o cliente
    // gravava direto e a regra tentava validar o formato — mas regra não checa
    // tamanho, nem tipo dos campos, nem se a URL de um anexo aponta pro nosso
    // bucket, e qualquer um podia sobrescrever ficha alheia sabendo o id.
    //
    // LEITURA por id segue aberta: o id é a credencial (mesmo modelo dos portais),
    // e a janela de revisão do corretor abre no Hosting, sem sessão de login.
    // Fechar isso exige token de acesso — próximo passo.
    match /fichas_locador/{id} {
      allow get:   if true;
      allow list:  if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    match /fichas/{id} {
      allow get:   if true;
      allow list:  if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // ─── Gestão de Locações · Bloco 1 ──────────────────────────────────────
    // Perfil vem da claim `locRole`; o bootstrap admin do Hub entra como gestor
    // pra conseguir criar o 1º gestor real (espelha a lógica das functions).
    function locGestor() {
      return request.auth != null
             && (request.auth.token.locRole == 'gestor'
                 || request.auth.uid == 'OwcT6wCrXMgJ0tPADMUdKdBB8h32');
    }
    function locAdministrativo() {
      return request.auth != null && request.auth.token.locRole == 'administrativo';
    }
    // Gestor e Administrativo leem tudo; corretor só o que ele captou.
    function locGestorOuAdmin() { return locGestor() || locAdministrativo(); }
    function locDono(rec) {
      return request.auth != null && rec.corretorUid == request.auth.uid;
    }
    function locPodeLer(rec) { return locGestorOuAdmin() || locDono(rec); }

    // Regra de ouro: leitura por corretorUid (corretor vê só os seus).
    // ESCRITA é sempre negada aqui — toda mutação passa por Cloud Function
    // (Admin SDK ignora estas regras), pra garantir integridade do financeiro.
    match /imoveis/{id}   { allow read: if locPodeLer(resource.data); allow write: if false; }
    // negocios: administrativo NÃO lê o doc cru (veria os comentarios internos, que a
    // negocioListar/_negocioSerializar esconde de quem não é gestor/corretor responsável).
    // Ele continua vendo os negócios pela Cloud Function (Admin SDK ignora esta regra).
    // Nenhuma tela lê negocios por SDK — só gestor e dono precisam do read direto.
    match /negocios/{id}  { allow read: if locGestor() || locDono(resource.data); allow write: if false; }
    // Configs do SMART HUB (tipos de imóvel, cidades, checklists): sem PII;
    // qualquer logado lê, escrita só via Cloud Function (configSalvar, admin).
    match /smarthub_config/{id} { allow read: if request.auth != null; allow write: if false; }
    match /pessoas/{id}   { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /contratos/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /garantias/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /cobrancas/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /repasses/{id}  { allow read: if locPodeLer(resource.data); allow write: if false; }
    match /vistorias/{id} { allow read: if locPodeLer(resource.data); allow write: if false; }

    // Perfis: cada um lê o seu; o gestor lista todos (pra futura tela de admin).
    match /loc_perfis/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || locGestor());
      allow write: if false; // só via Cloud Function (locDefinirPerfil)
    }

    // ===================== H-REC AGENDA (módulo de fotografia) =====================
    // Papéis vêm de claims { role, imobiliariaId } (mintadas por Cloud Function, Bloco 5).
    // ESCRITA sempre negada aqui: bookings/credits/payments e todo o resto passam por
    // Cloud Function (Admin SDK ignora estas regras). Leitura escopada.
    // Staff H-REC = fotografo/administrador (veem tudo); broker vê a própria imobiliária;
    // corretor/avulso veem só o que é seu. ⚠️ A disponibilidade da agenda NÃO é lida
    // varrendo `bookings` no cliente (vazaria PII de todos) — vem por Cloud Function que
    // devolve só os intervalos ocupados/slots, sem PII (desvio consciente do MD §7).
    function hrecRole()          { return request.auth != null ? request.auth.token.hrecRole : null; }
    function hrecStaff()         { return hrecRole() == 'administrador' || hrecRole() == 'fotografo'; }
    function hrecMinhaImob(imob) { return request.auth != null && request.auth.token.hrecImob == imob; }

    // Catálogo/config: qualquer logado LÊ (pra montar preço/agenda/pagamento).
    match /pricingTables/{id}      { allow read: if request.auth != null; allow write: if false; }
    match /servicosAdicionais/{id} { allow read: if request.auth != null; allow write: if false; }
    match /imobiliarias/{id}       { allow read: if request.auth != null; allow write: if false; }
    match /blockedDates/{iso}      { allow read: if request.auth != null; allow write: if false; }
    match /config/agenda           { allow read: if request.auth != null; allow write: if false; }
    match /config/pix              { allow read: if request.auth != null; allow write: if false; }

    // Bookings: dono (corretor) OU broker da imobiliária OU staff H-REC.
    match /bookings/{id} {
      allow read: if request.auth != null && (
        resource.data.corretorId == request.auth.uid ||
        hrecStaff() ||
        (hrecRole() == 'broker' && hrecMinhaImob(resource.data.imobiliariaId))
      );
      allow write: if false;
    }

    // Financeiro (mais restrito): broker da imobiliária OU staff H-REC.
    match /payments/{id} {
      allow read: if request.auth != null && (hrecStaff() ||
        (hrecRole() == 'broker' && hrecMinhaImob(resource.data.imobiliariaId)));
      allow write: if false;
    }
    match /credits/{imobId} {
      allow read: if request.auth != null && (hrecStaff() ||
        (hrecRole() == 'broker' && hrecMinhaImob(imobId)));
      allow write: if false;
    }
    match /creditMovements/{id} {
      allow read: if request.auth != null && (hrecStaff() ||
        (hrecRole() == 'broker' && hrecMinhaImob(resource.data.imobiliariaId)));
      allow write: if false;
    }
    // Histórico de preços = auditoria: só staff H-REC.
    match /pricingHistory/{id} { allow read: if hrecStaff(); allow write: if false; }
    // Notificações in-app: só o dono LÊ; escrita só via Cloud Function.
    match /hrec_notifs/{id} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow write: if false; }
  }
}
